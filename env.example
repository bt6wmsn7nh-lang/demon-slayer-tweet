const state = { user: null, posts: [] };

const $ = (selector) => document.querySelector(selector);
const feed = $("#feed");
const authCard = $("#authCard");
const composer = $("#composer");
const profileCard = $("#profileCard");
const profileDialog = $("#profileDialog");
const toast = $("#toast");

function showToast(message, error = false) {
  toast.textContent = message;
  toast.className = `toast show${error ? " error" : ""}`;
  clearTimeout(showToast.timer);
  showToast.timer = setTimeout(() => toast.className = "toast", 2600);
}

async function request(url, options = {}) {
  const response = await fetch(url, {
    headers: { "Content-Type": "application/json", ...(options.headers || {}) },
    ...options
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.error || "Something went wrong.");
  return data;
}

function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"
  })[char]);
}

function styleChar(style) {
  return ({ water: "水", flame: "炎", mist: "霞", thunder: "雷", flower: "花" })[style] || "水";
}

function styleClass(style) {
  return style === "mist" ? "mist-style" : style || "water";
}

function relativeTime(dateString) {
  const seconds = Math.floor((Date.now() - new Date(dateString).getTime()) / 1000);
  if (seconds < 60) return "now";
  if (seconds < 3600) return `${Math.floor(seconds / 60)}m`;
  if (seconds < 86400) return `${Math.floor(seconds / 3600)}h`;
  if (seconds < 604800) return `${Math.floor(seconds / 86400)}d`;
  return new Date(dateString).toLocaleDateString();
}

function updateUI() {
  const loggedIn = Boolean(state.user);
  authCard.classList.toggle("hidden", loggedIn);
  composer.classList.toggle("hidden", !loggedIn);
  profileCard.classList.toggle("hidden", !loggedIn);

  $("#headerActions").innerHTML = loggedIn
    ? `<button id="logoutButton" class="secondary">Log out</button>`
    : `<span class="muted">Join the Corps</span>`;

  if (loggedIn) {
    const cls = styleClass(state.user.avatar_style);
    const char = styleChar(state.user.avatar_style);
    $("#profileAvatar").className = `avatar avatar-large ${cls}`;
    $("#profileAvatar").textContent = char;
    $("#composerAvatar").className = `avatar ${cls}`;
    $("#composerAvatar").textContent = char;
    $("#profileName").textContent = state.user.display_name;
    $("#profileUsername").textContent = `@${state.user.username}`;
    $("#profileBio").textContent = state.user.bio || "No bio yet.";

    $("#logoutButton").onclick = async () => {
      await request("/api/logout", { method: "POST" });
      state.user = null;
      updateUI();
      loadFeed();
      showToast("Logged out.");
    };
  }
}

function renderFeed() {
  if (!state.posts.length) {
    feed.innerHTML = `<div class="card empty">No tweets yet. Be the first to post.</div>`;
    return;
  }

  feed.innerHTML = state.posts.map(post => {
    const ownPost = state.user && String(state.user.id) === String(post.user_id);
    return `
      <article class="card post" data-post-id="${post.id}">
        <div class="post-head">
          <div class="avatar ${styleClass(post.avatar_style)}">${styleChar(post.avatar_style)}</div>
          <div class="post-meta">
            <span class="post-name">${escapeHtml(post.display_name)}</span>
            <span class="post-user">@${escapeHtml(post.username)}</span>
            <span class="post-time"> · ${relativeTime(post.created_at)}</span>
          </div>
        </div>
        <div class="post-content">${escapeHtml(post.content)}</div>
        <div class="post-actions">
          <button class="action-button like-button ${post.liked_by_me ? "liked" : ""}" data-id="${post.id}">
            ${post.liked_by_me ? "♥" : "♡"} <span>${post.like_count}</span>
          </button>
          ${ownPost ? `<button class="action-button delete-button" data-id="${post.id}">Delete</button>` : ""}
        </div>
      </article>
    `;
  }).join("");

  document.querySelectorAll(".like-button").forEach(button => {
    button.addEventListener("click", async () => {
      if (!state.user) return showToast("Log in to like posts.", true);
      try {
        const data = await request(`/api/posts/${button.dataset.id}/like`, { method: "POST" });
        button.classList.toggle("liked", data.liked);
        button.innerHTML = `${data.liked ? "♥" : "♡"} <span>${data.likeCount}</span>`;
      } catch (error) {
        showToast(error.message, true);
      }
    });
  });

  document.querySelectorAll(".delete-button").forEach(button => {
    button.addEventListener("click", async () => {
      if (!confirm("Delete this post?")) return;
      try {
        await request(`/api/posts/${button.dataset.id}`, { method: "DELETE" });
        state.posts = state.posts.filter(post => String(post.id) !== button.dataset.id);
        renderFeed();
        showToast("Post deleted.");
      } catch (error) {
        showToast(error.message, true);
      }
    });
  });
}

async function loadMe() {
  try {
    const data = await request("/api/me");
    state.user = data.user;
    updateUI();
  } catch (error) {
    showToast(error.message, true);
  }
}

async function loadFeed() {
  try {
    const data = await request("/api/feed");
    state.posts = data.posts;
    renderFeed();
  } catch (error) {
    feed.innerHTML = `<div class="card empty">${escapeHtml(error.message)}</div>`;
  }
}

document.querySelectorAll(".tab").forEach(tab => {
  tab.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(item => item.classList.toggle("active", item === tab));
    $("#loginForm").classList.toggle("hidden", tab.dataset.tab !== "login");
    $("#signupForm").classList.toggle("hidden", tab.dataset.tab !== "signup");
  });
});

$("#loginForm").addEventListener("submit", async event => {
  event.preventDefault();
  const form = new FormData(event.currentTarget);
  try {
    const data = await request("/api/login", {
      method: "POST",
      body: JSON.stringify(Object.fromEntries(form))
    });
    state.user = data.user;
    event.currentTarget.reset();
    updateUI();
    await loadFeed();
    showToast("Welcome back.");
  } catch (error) {
    showToast(error.message, true);
  }
});

$("#signupForm").addEventListener("submit", async event => {
  event.preventDefault();
  const form = new FormData(event.currentTarget);
  try {
    const data = await request("/api/signup", {
      method: "POST",
      body: JSON.stringify(Object.fromEntries(form))
    });
    state.user = data.user;
    event.currentTarget.reset();
    updateUI();
    await loadFeed();
    showToast("Account created.");
  } catch (error) {
    showToast(error.message, true);
  }
});

$("#postContent").addEventListener("input", event => {
  $("#charCount").textContent = `${event.target.value.length} / 280`;
});

$("#postForm").addEventListener("submit", async event => {
  event.preventDefault();
  const content = $("#postContent").value;
  try {
    await request("/api/posts", {
      method: "POST",
      body: JSON.stringify({ content })
    });
    $("#postContent").value = "";
    $("#charCount").textContent = "0 / 280";
    await loadFeed();
    showToast("Tweet published.");
  } catch (error) {
    showToast(error.message, true);
  }
});

$("#refreshButton").addEventListener("click", loadFeed);

$("#editProfileButton").addEventListener("click", () => {
  $("#editDisplayName").value = state.user.display_name;
  $("#editBio").value = state.user.bio || "";
  const radio = document.querySelector(`input[name="avatarStyle"][value="${state.user.avatar_style}"]`);
  if (radio) radio.checked = true;
  profileDialog.showModal();
});

$("#closeDialog").addEventListener("click", () => profileDialog.close());

$("#profileForm").addEventListener("submit", async event => {
  event.preventDefault();
  const avatarStyle = document.querySelector('input[name="avatarStyle"]:checked')?.value || "water";
  try {
    const data = await request("/api/profile", {
      method: "PATCH",
      body: JSON.stringify({
        displayName: $("#editDisplayName").value,
        bio: $("#editBio").value,
        avatarStyle
      })
    });
    state.user = data.user;
    profileDialog.close();
    updateUI();
    await loadFeed();
    showToast("Profile saved.");
  } catch (error) {
    showToast(error.message, true);
  }
});

(async function start() {
  await loadMe();
  await loadFeed();
})();
